{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: Uvicorn",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--app-dir",
                "backend",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8001"
            ],
            "envFile": "${workspaceFolder}/.env",
            "jinja": true
        }
    ]
}
