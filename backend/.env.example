# Application
APP_NAME=Solar & Wind Deployment Intelligence Platform
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# Database
# Replace these values with your actual local database credentials
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5433/solar_wind_db
POSTGRES_DB=solar_wind_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Settings
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# Dataset Paths
NASA_POWER_DATA_PATH=datasets/nasa_power
GLOBAL_WIND_ATLAS_PATH=datasets/global_wind_atlas
SENTINEL_PATH=datasets/sentinel
OSM_PATH=datasets/openstreetmap
SRTM_PATH=datasets/srtm

# ML Model Paths
SOLAR_MODEL_PATH=models/solar_prediction_model.joblib
WIND_MODEL_PATH=models/wind_prediction_model.joblib
SITE_MODEL_PATH=models/site_suitability_model.joblib

# Reports
REPORTS_OUTPUT_PATH=reports/
